{
  "name": "protokol-zdawczo-odbiorczy",
  "version": "1.0.0",
  "private": true,
  "description": "Generator protokołu zdawczo-odbiorczego mieszkania ze zdjęciami i podpisami (PDF) + kalkulator taksy notarialnej, PCC i ryczałtu od najmu.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run vendor && npm run build:css",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/input.css -o public/assets/app.css --minify",
    "vendor": "node scripts/vendor.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "serve": "node scripts/serve.mjs",
    "keys": "node scripts/generuj-klucze.mjs",
    "domain": "node scripts/ustaw-domene.mjs"
  },
  "devDependencies": {
    "pdfmake": "0.3.11",
    "tailwindcss": "3.4.18"
  }
}
